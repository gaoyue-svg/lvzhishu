# ============================================================================
# LawAgent 环境变量示例
# 使用方法：复制为 .env 并填写真实值
#   cp .env.example .env
# 警告：.env 文件包含敏感信息，已加入 .gitignore，请勿提交
# ============================================================================

# ===== 应用基础 =====
APP_ENV=development
APP_NAME=LawAgent
APP_DEBUG=true
CORS_ORIGINS=*

# ===== MySQL 数据库 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=please-change-me
MYSQL_DATABASE=lawrag
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/4

# ===== JWT 鉴权（生产必须修改为强随机字符串，至少 32 字符）=====
JWT_SECRET=please-change-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320
REFRESH_TOKEN_EXPIRE_DAYS=3

# ===== 阿里云 OSS 对象存储 =====
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_DOCUMENTS_BUCKET=lawrag-documents
OSS_REPORTS_BUCKET=lawrag-reports
OSS_DOWNLOAD_RETRY=3
OSS_DOWNLOAD_RETRY_BACKOFF=1.0

# ===== Milvus 向量库 =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# ===== Embedding 向量化 =====
# 注意：EMBEDDING_DIM 必须与已有 Milvus Collection 维度一致；Collection 不存在时跳过校验
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
MAX_EMBEDDING_TOKENS=500
EMBEDDING_BATCH_SIZE=100
MILVUS_UPSERT_BATCH_SIZE=1000
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=2592000
EMBEDDING_CACHE_SCOPE=tenant

# ===== Rerank 重排 =====
RERANKER_PROVIDER=rule
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_API_BASE=http://localhost:8081/rerank

# ===== BM25 与分词 =====
BM25_INDEX_DIR=storage/bm25
TOKENIZER_PROVIDER=jieba
TOKENIZER_DICT_PATH=
CONTEXT_MAX_TOKENS=8000

# ===== 全局 LLM（用户未配置 BYOK 时回退使用）=====
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_BASE=
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_RETRY=2

# ===== BYOK 用户自带 Key =====
# LLM_CONFIG_SECRET 为空时回退到 JWT_SECRET 派生，仅限开发环境
LLM_CONFIG_SECRET=
BYOK_ENABLED=true
BYOK_FALLBACK_TO_GLOBAL=true

# ===== Router Agent =====
ROUTER_LLM_TEMPERATURE=0.1
ROUTER_LLM_MAX_TOKENS=800
ROUTER_LLM_TIMEOUT=8
ROUTER_LLM_RETRY=2
ROUTER_CONFIDENCE_THRESHOLD=0.6
ROUTER_CONFIDENCE_MAX=0.95

# ===== Agent 短期记忆 =====
AGENT_MEMORY_TTL=86400
AGENT_MEMORY_MAX_TURNS=6
AGENT_MEMORY_MAX_TOKENS=12000
AGENT_MEMORY_SUMMARY_TRIGGER_TOKENS=9000
AGENT_MEMORY_SUMMARY_TOKENS=3000
AGENT_MEMORY_RECENT_TOKENS=7500
AGENT_RETRY_MAX=1
LANGGRAPH_CHECKPOINT_ENABLED=false

# ===== 联网搜索 =====
# WEB_SEARCH_PROVIDER: tavily | bing_mcp
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_API_BASE=https://api.tavily.com
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced
TAVILY_INCLUDE_RAW_CONTENT=true
TAVILY_FULL_TEXT_LIMIT=6000

# ===== MCP 客户端（必应搜索 MCP）=====
MCP_ENABLED=false
MCP_CLIENT_TIMEOUT=30.0
MCP_CONNECT_RETRY=2
BING_MCP_SERVER_URL=
BING_MCP_TOOL_NAME=bing_search
BING_MCP_TIMEOUT=30.0

# ===== OCR =====
# OCR_PROVIDER: rapidocr(默认) | none
# 注意：项目使用 RapidOCR(onnxruntime)，不使用 PaddleOCR（无 Python 3.14 wheel）
OCR_PROVIDER=rapidocr
PADDLE_OCR_LANG=ch
PADDLE_USE_GPU=false
OCR_MIN_CHARS_PER_PAGE=50

# ===== 阿里云 OCR（可选，按量计费；未配置密钥则仅走本地 RapidOCR）=====
ALIYUN_OCR_ENABLED=false
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_REGION=cn-shanghai
ALIYUN_OCR_MAX_PAGES=100

# ===== 引用校验 =====
CITATION_VALIDATION_ENABLED=true

# ===== Supervisor 多 Agent V1 =====
SUPERVISOR_ENABLED=true
SUPERVISOR_MAX_ROUNDS=5
SUPERVISOR_LLM_TEMPERATURE=0.2
SUPERVISOR_LLM_MAX_TOKENS=512
SUPERVISOR_LLM_TIMEOUT=15
SUPERVISOR_LLM_RETRY=1
SUPERVISOR_MAX_AGENT_CALLS=2
SYNTHESIZER_TEMPERATURE=0.3

# ===== 查询改写 =====
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_LLM_ENABLED=false
QUERY_REWRITE_LLM_TEMPERATURE=0.1
QUERY_REWRITE_LLM_MAX_TOKENS=256
QUERY_REWRITE_LLM_TIMEOUT=15
QUERY_REWRITE_LLM_RETRY=1

# ===== 多 Agent v2 编排（灰度）=====
MULTIAGENT_V2_ENABLED=false
PLAN_MAX_STEPS=4
PLANNER_LLM_TEMPERATURE=0.1
PLANNER_LLM_MAX_TOKENS=1024
PLANNER_LLM_TIMEOUT=15
PLANNER_LLM_RETRY=1
STEP_TIMEOUT=60.0
STEP_RETRY=1
REPLAN_MAX=1
CONTRACT_RAG_MAX_QUERIES=3
CONTRACT_RAG_QUERY_TIMEOUT=12.0
REVIEW_RETRY_MAX=1
REVIEW_L2_ENABLED=true
REVIEW_L2_SAMPLE_MAX=3
SYNTH_CONTEXT_MAX_TOKENS=8000
MODEL_TIER_CHEAP=
MODEL_TIER_STRONG=

# ===== 内嵌 Worker 开关 =====
# 开发环境 true：后端进程内嵌四个 Worker，无需单独启动
# 生产环境建议 false：使用独立 Worker 进程横向扩展
INLINE_WORKERS=true

# ===== 文档版面解析 MinerU =====
MINERU_ENABLED=false
MINERU_API_URL=
MINERU_BACKEND=
MINERU_METHOD=auto
MINERU_LANG=ch
MINERU_TIMEOUT_SECONDS=3600

# ===== 知识库文档上传 =====
# 单文件上限，默认 200 MB；大型法律汇编 PDF 可直接上传。
KNOWLEDGE_UPLOAD_MAX_BYTES=209715200

# ===== 会话临时上传（合同分析）=====
CHAT_UPLOAD_TTL_HOURS=24
CHAT_UPLOAD_MAX_BYTES=52428800

# ===== Agent Harness 治理层 =====
HARNESS_ENABLED=true
HARNESS_TRACE_ENABLED=true
HARNESS_METRICS_ENABLED=true
LLM_USAGE_ENABLED=true
EVALUATION_ENABLED=true
EVALUATION_SAMPLE_RATE=0.05
EXPERIMENT_ENABLED=true

# ===== Prompt 版本全局覆盖（JSON 格式，如 {"law_qa_system": "v2"}）=====
PROMPT_VERSION_OVERRIDES={}

# ===== Input Guard 护栏 =====
GUARD_ENABLED=true
GUARD_MAX_QUERY_CHARS=4000
GUARD_MAX_UPLOAD_FILES=10
GUARD_PROMPT_INJECTION_ENABLED=true
GUARD_BLOCKED_KEYWORDS=
GUARD_REQUEST_TOKEN_CAP=4000
GUARD_USER_DAILY_TOKEN_QUOTA=200000
GUARD_MAX_CONCURRENCY=3
